<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/actionChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        app:chipSpacingHorizontal="4dp"
        app:chipSpacingVertical="2dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/btnAdd"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add"
            android:textSize="12sp"
            app:chipIcon="@drawable/ic_add"
            app:chipIconSize="16dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/btnImport"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/batch_import"
            android:textSize="12sp"
            app:chipIcon="@drawable/ic_upload"
            app:chipIconSize="16dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/btnAi"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_recommend"
            android:textSize="12sp"
            app:chipIcon="@drawable/ic_auto_awesome"
            app:chipIconSize="16dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/btnSourcePrompt"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/site_source_button"
            android:textSize="12sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/btnSelectAll"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_all"
            android:textSize="12sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/btnBatchDelete"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/batch_delete"
            android:textColor="@color/level_error"
            android:textSize="12sp"
            app:chipIcon="@drawable/ic_delete"
            app:chipIconSize="16dp" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:id="@+id/tvCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="2dp"
        android:paddingEnd="16dp"
        android:paddingBottom="2dp"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvWebsites"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_websites"
            android:textColor="@color/on_surface_variant"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
